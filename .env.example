# Local development values. Copy to .env if you want to override defaults; .env is git-ignored.
# The defaults below are already built in, so this file is documentation first.
# Production secrets live only in AWS SSM Parameter Store and are never set here.

AWS_REGION=eu-central-1
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_NAME=pophq-local
OIDC_ISSUER=http://localhost:8081/pophq
API_PORT=3000

# Web app (Vite reads VITE_* variables)
VITE_OIDC_ISSUER=http://localhost:8081/pophq
VITE_OIDC_CLIENT_ID=pophq-web
